# Porta da API
PORT=3000

# Origem liberada no CORS (front-end Vite)
CORS_ORIGIN=http://localhost:5173

# Segredo de assinatura do JWT (troque em producao)
JWT_SECRET=washflow-dev-secret
JWT_EXPIRES_IN=8h

# Banco de dados
# DB_DIALECT=sqlite  -> desenvolvimento local, nao exige instalacao
# DB_DIALECT=postgres -> alvo documentado no C4 Nivel 2
DB_DIALECT=sqlite
DB_STORAGE=washflow.sqlite

DB_HOST=localhost
DB_PORT=5432
DB_NAME=washflow_db
DB_USER=postgres
DB_PASSWORD=

# Telegram Bot API — cada cliente se vincula ao seu chat privado por /start
# BotFather gera TOKEN e USERNAME; nunca versionar token de verdade.
# Sem webhooks: este MVP utiliza getUpdates (polling) na propria API.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
