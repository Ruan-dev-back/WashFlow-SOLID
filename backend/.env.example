# Porta da API
PORT=3000

# Origem liberada no CORS (front-end Vite)
CORS_ORIGIN=http://localhost:5173

# Segredo de assinatura do JWT (troque em producao)
JWT_SECRET=washflow-dev-secret
JWT_EXPIRES_IN=8h

# Banco de dados
# DB_DIALECT=sqlite  -> desenvolvimento local, nao exige instalacao
# DB_DIALECT=postgres -> alvo documentado no C4 Nivel 2
DB_DIALECT=sqlite
DB_STORAGE=washflow.sqlite

DB_HOST=localhost
DB_PORT=5432
DB_NAME=washflow_db
DB_USER=postgres
DB_PASSWORD=

# Telegram Bot API - somente ambiente de demonstracao
# O usuario deve enviar /start ao bot, ou adiciona-lo ao grupo, antes de receber mensagens.
# Chat fixo de teste; o MVP NAO faz pareamento automatico de clientes por telefone.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
